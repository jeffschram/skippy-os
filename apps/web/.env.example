# Copy to apps/web/.env.local and fill in. Never commit the copy.

# The MCP endpoint's public URL. It is the OAuth resource: Clerk puts it in each
# access token's `aud`, and the endpoint accepts no other audience.
# Local: http://localhost:3000/api/mcp   Hosted: https://<project>.vercel.app/api/mcp
SKIPPY_MCP_RESOURCE_URL=http://localhost:3000/api/mcp

# The Convex deployment URL (the CONVEX_URL that `convex dev` writes to the root .env.local).
CONVEX_URL=

# Shared with Convex, where it is set with `npx convex env set SKIPPY_GATEWAY_SECRET ...`.
# At least 32 characters. Generate one with: openssl rand -base64 36
SKIPPY_GATEWAY_SECRET=

# From the Clerk dashboard, API keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Stops the Clerk SDK from sending usage telemetry.
CLERK_TELEMETRY_DISABLED=1
